{
  "name": "@platform/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env.local --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=../../.env.local dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@platform/contracts": "*",
    "@platform/database": "*",
    "@platform/domain": "*",
    "@platform/observability": "*",
    "fastify": "5.12.3",
    "fastify-raw-body": "6.0.1",
    "jose": "6.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@platform/github-adapter": "*",
    "@platform/provider-framework": "*",
    "@types/node": "22.20.1",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
