{
  "name": "@platform/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env.local --import tsx --watch src/server.ts",
    "benchmark:temporal-worker": "node --env-file-if-exists=../../.env.local --import tsx src/temporal-benchmark-server.ts",
    "benchmark:temporal": "node --env-file-if-exists=../../.env.local --import tsx src/temporal-benchmark-cli.ts",
    "start": "node --env-file-if-exists=../../.env.local dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@platform/contracts": "*",
    "@platform/database": "*",
    "@platform/domain": "*",
    "@platform/observability": "*",
    "@platform/vercel-blob-artifacts": "*",
    "@platform/vercel-sandbox-runner": "*",
    "@temporalio/activity": "1.22.0",
    "@temporalio/client": "1.22.0",
    "@temporalio/common": "1.22.0",
    "@temporalio/worker": "1.22.0",
    "@temporalio/workflow": "1.22.0",
    "fastify": "5.12.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@temporalio/testing": "1.22.0",
    "@platform/provider-framework": "*",
    "@types/node": "22.20.1",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
