{
  "name": "@platform/vercel-sandbox-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vercel Sandbox production-isolation runner adapter",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "benchmark:live-image": "node --env-file-if-exists=../../.env.local --import tsx src/live-image-benchmark.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@platform/contracts": "*",
    "@platform/domain": "*",
    "@vercel/sandbox": "3.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  }
}
