FROM node:22.16.0-bookworm-slim@sha256:048ed02c5fd52e86fda6fbd2f6a76cf0d4492fd6c6fee9e2c463ed5108da0e34 AS build

WORKDIR /source
COPY . .
RUN npm ci \
    && npm exec turbo -- run build --filter=@platform/vercel-sandbox-runner...

FROM node:22.16.0-bookworm-slim@sha256:048ed02c5fd52e86fda6fbd2f6a76cf0d4492fd6c6fee9e2c463ed5108da0e34

ARG SOURCE_REVISION
LABEL org.opencontainers.image.title="AI Website Platform isolated runner" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.source="https://github.com/karthik18mohan/ai-website-engineering-platform"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git tini util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 runner \
    && useradd --uid 10001 --gid 10001 --home-dir /home/runner --create-home --shell /usr/sbin/nologin runner \
    && install --directory --owner=runner --group=runner --mode=0700 /home/runner/.platform-control \
    && install --directory --owner=root --group=root --mode=0755 /opt/ai-website-platform/bin \
    && install --directory --owner=runner --group=runner --mode=0750 /workspace \
    && test ! -e /usr/bin/sudo

COPY --from=build --chown=root:root /source/packages/vercel-sandbox-runner/dist/broker-protocol.js /source/packages/vercel-sandbox-runner/dist/image-policy.js /opt/ai-website-platform/bin/
COPY --from=build --chown=root:root /source/packages/vercel-sandbox-runner/dist/broker-main.js /opt/ai-website-platform/bin/runner-exec
COPY --from=build --chown=root:root /source/node_modules/zod /opt/ai-website-platform/node_modules/zod

RUN chmod 0555 /opt/ai-website-platform/bin/*.js /opt/ai-website-platform/bin/runner-exec \
    && /opt/ai-website-platform/bin/runner-exec --self-check \
    && test "$(node --version)" = "v22.16.0"

USER runner:runner
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
